---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import StructuredData from '../components/StructuredData.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = 'Boutique dental care in Minnetonka, MN. Dr. Michael Sudit, DDS — 40+ years of clinical excellence and Disney-inspired patient service.',
  image,
  type = 'website',
  noindex = false,
} = Astro.props;

const SITE_URL = 'https://www.drsudit.com';

// Stable @id so every page's markup resolves to the one practice entity rather
// than looking like 77 separate businesses.
const practiceId = `${SITE_URL}/#practice`;

const organizationData = {
  "@id": practiceId,
  name: "Center for Smile Enhancement",
  alternateName: "Dr. Michael Sudit, DDS",
  url: SITE_URL,
  logo: new URL('/images/logo-banner.jpg', Astro.site).href,
  image: new URL('/images/og-default.jpg', Astro.site).href,
  description: "Boutique cosmetic, general, and family dental care in Minnetonka, MN from Dr. Michael Sudit, DDS.",
  telephone: "+19525939310",
  email: "TheCenterforSmileEnhancement@PDPSmiles.com",
  address: {
    "@type": "PostalAddress",
    streetAddress: "10500 Wayzata Blvd.",
    addressLocality: "Minnetonka",
    addressRegion: "MN",
    postalCode: "55305",
    addressCountry: "US",
  },
  hasMap: "https://www.google.com/maps/search/?api=1&query=10500+Wayzata+Blvd,+Minnetonka,+MN+55305",
  areaServed: [
    { "@type": "City", name: "Minnetonka", addressRegion: "MN" },
    { "@type": "City", name: "Wayzata", addressRegion: "MN" },
    { "@type": "City", name: "Hopkins", addressRegion: "MN" },
    { "@type": "City", name: "Eden Prairie", addressRegion: "MN" },
    { "@type": "City", name: "Plymouth", addressRegion: "MN" },
  ],
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday"],
      opens: "08:00",
      closes: "17:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Friday",
      opens: "08:00",
      closes: "12:00",
    },
  ],
  priceRange: "$$$$",
  currenciesAccepted: "USD",
  medicalSpecialty: "https://schema.org/Dentistry",
  availableService: [
    { "@type": "MedicalProcedure", name: "Cosmetic Dentistry" },
    { "@type": "MedicalProcedure", name: "General & Family Dentistry" },
    { "@type": "MedicalProcedure", name: "Implant Dentistry" },
    { "@type": "MedicalProcedure", name: "Orthodontics" },
    { "@type": "MedicalProcedure", name: "TMJ & Facial Pain Treatment" },
    { "@type": "MedicalProcedure", name: "Emergency Dentistry" },
  ],
};

// WebSite entity — lets search engines attach the site name to results.
const websiteData = {
  "@id": `${SITE_URL}/#website`,
  name: "Center for Smile Enhancement",
  url: SITE_URL,
  publisher: { "@id": practiceId },
  inLanguage: "en-US",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Lato:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" href="/favicon.ico" sizes="48x48 32x32 16x16" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <meta name="theme-color" content="#1e3460" />

    <SEOHead
      title={title}
      description={description}
      image={image}
      type={type}
      noindex={noindex}
    />

    <StructuredData type="Dentist" data={organizationData} />
    <StructuredData type="WebSite" data={websiteData} />

    <script type="text/javascript" src="https://www.bugherd.com/sidebarv2.js?apikey=fumnsoe2xkixj7dl3deu2q" async="true" is:inline></script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />
  </body>
</html>
