---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';

const businessName = 'Center for Smile Enhancement';
const contactEmail = 'TheCenterforSmileEnhancement@PDPSmiles.com';
const lastUpdated = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title="Terms of Use | Center for Smile Enhancement, Minnetonka"
  description="Review the Terms of Use governing your access to the Center for Smile Enhancement website, covering acceptable use, intellectual property, and liability."
  noindex={true}
>
  <Header />

  <main id="main-content">
    <PageHero
      eyebrow="Legal"
      title="Terms of Use"
      breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Terms of Use' }]}
    />

    <section aria-labelledby="terms-content-heading" class="section-white">
      <div class="site-container section-py">
        <h2 id="terms-content-heading" class="sr-only">Terms of Use Details</h2>
        <div class="article-prose">
          <p class="last-updated">Last updated: {lastUpdated}</p>

          <h2>Agreement to Terms</h2>
          <p>
            These Terms of Use govern your access to and use of the {businessName} website. By visiting or
            using this website, you agree to be bound by these terms. If you do not agree, please do not use
            this website.
          </p>

          <h2>Informational Purposes Only</h2>
          <p>
            The content on this website is provided for general informational purposes about our practice and
            services only. It is not intended as, and should not be relied upon as, dental or medical advice,
            diagnosis, or treatment recommendations. Always consult with Dr. Sudit or another qualified
            healthcare provider regarding any questions you may have about a dental or health condition, and
            before making any decisions related to your care.
          </p>

          <h2>Acceptable Use</h2>
          <p>When using our website, you agree not to:</p>
          <ul>
            <li>Use the site for any unlawful purpose or in violation of any applicable laws</li>
            <li>Attempt to gain unauthorized access to our systems or networks</li>
            <li>Interfere with or disrupt the site's operation or security features</li>
            <li>Copy, scrape, or reproduce site content for commercial purposes without permission</li>
            <li>Transmit any harmful code, malware, or unsolicited advertising</li>
          </ul>

          <h2>Intellectual Property</h2>
          <p>
            All content on this website, including text, graphics, logos, images, and software, is the
            property of {businessName} or its content suppliers and is protected by applicable copyright and
            trademark laws. You may view and print content for personal, non-commercial use only.
          </p>

          <h2>Third-Party Links</h2>
          <p>
            Our website may contain links to third-party websites, including insurance, financing, or patient
            portal providers. We do not control and are not responsible for the content or practices of any
            linked third-party sites.
          </p>

          <h2>Limitation of Liability</h2>
          <p>
            This website and its content are provided "as is" without warranties of any kind, express or
            implied. To the fullest extent permitted by law, {businessName} shall not be liable for any
            indirect, incidental, or consequential damages arising from your use of, or inability to use, this
            website.
          </p>

          <h2>Governing Law</h2>
          <p>
            These Terms of Use are governed by the laws of the State of Minnesota, without regard to its
            conflict of law principles.
          </p>

          <h2>Changes to These Terms</h2>
          <p>
            We may revise these Terms of Use at any time. Changes will be posted on this page with an updated
            revision date, and your continued use of the site constitutes acceptance of those changes.
          </p>

          <h2>Contact Us</h2>
          <p>
            <strong>{businessName}</strong><br />
            10500 Wayzata Blvd., Minnetonka, MN 55305<br />
            Phone: <a href="tel:9525939310">952-593-9310</a><br />
            Email: <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
          </p>

          <p class="pending-note">
            These terms will be finalized in coordination with our compliance team as part of our ongoing
            legal review.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .section-white { background-color: #ffffff; }
  .last-updated {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }
  .pending-note {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
