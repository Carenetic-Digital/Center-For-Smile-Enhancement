---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import CTABand from '../../components/CTABand.astro';

// Every post directory under src/pages/blog/ exports `postMeta`. The index picks
// them all up automatically and orders them newest-first by publish date, matching
// the live site. The date is used for sorting only and is never rendered.
const modules = import.meta.glob('./*/index.astro', { eager: true });

const posts = Object.entries(modules)
  .map(([path, mod]) => {
    const slug = path.split('/')[1];
    return { ...(mod as any).postMeta, href: `/blog/${slug}/` };
  })
  .filter((post) => post.title && post.date)
  .sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0));
---

<BaseLayout
  title="Dental Health Blog | Center for Smile Enhancement"
  description="Read the latest articles on cosmetic, restorative, and family dentistry, plus patient education from Center for Smile Enhancement in Minnetonka, MN."
>
  <Header />

  <main id="main-content">
    <PageHero
      eyebrow="Patient Education"
      title="The Center for Smile Enhancement Blog"
      lede="Insights on cosmetic, restorative, and family dentistry, plus practical guidance for keeping your smile healthy — from Dr. Sudit and our Minnetonka team."
      breadcrumbs={[
        { label: 'Home', href: '/' },
        { label: 'Blog' },
      ]}
    />

    <section aria-labelledby="blog-grid-heading" class="section-surface">
      <div class="site-container section-py">
        <h2 id="blog-grid-heading" class="sr-only">All Blog Articles</h2>

        <div class="blog-grid">
          {posts.map((post) => (
            <a href={post.href} class="card blog-card">
              <span class="blog-card-category">{post.category}</span>
              <h3 class="blog-card-title">{post.title}</h3>
              <p class="blog-card-excerpt">{post.excerpt}</p>
              <span class="blog-card-cta" aria-hidden="true">
                Read More
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <CTABand
      heading="Have a Question We Didn't Cover?"
      sub="Reach out to our team — we're happy to help, whether you're a new or returning patient."
    />
  </main>

  <Footer />
</BaseLayout>

<style>
  .section-surface { background-color: var(--color-surface); }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .blog-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .blog-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .blog-card-category {
    display: inline-flex;
    align-self: flex-start;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
    background-color: var(--color-brand-light);
    border-radius: 999px;
    padding: 0.3125rem 0.8125rem;
    margin-bottom: 1rem;
  }

  .blog-card-title {
    font-size: 1.0625rem;
    font-weight: 600;
    font-family: var(--font-display);
    color: var(--color-primary);
    line-height: 1.35;
    margin-bottom: 0.625rem;
  }

  .blog-card-excerpt {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    flex-grow: 1;
  }

  .blog-card-cta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
</style>
