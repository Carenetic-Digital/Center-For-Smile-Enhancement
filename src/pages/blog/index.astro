    category: 'Teledentistry',
    href: '/blog/your-dentist-from-anywhere-discover-the-convenience-of-teledentistry-in-minnetonk/',
  },
  {
    title: 'Your Guide to Porcelain Veneers in Minnetonka, MN',
    excerpt: 'How porcelain veneers work, what to expect from the process, and how to care for your new smile.',
    category: 'Cosmetic Dentistry',
    href: '/blog/your-guide-to-porcelain-veneers-in-minnetonka-mn/',
  },
