import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHero from '../../../components/PageHero.astro';
import CTABand from '../../../components/CTABand.astro';
import StructuredData from '../../../components/StructuredData.astro';

const articleData = {
  headline: 'Rejuvenate Your Look: Exploring Masterpiece Aesthetics at Our Minnetonka Clinic',
  description:
    'Explore Masterpiece Aesthetics at Center for Smile Enhancement — Botox, dermal fillers, microneedling, and skin treatments in Minnetonka, MN.',
  datePublished: '2025-09-19',
  author: {
    '@type': 'Organization',
    name: 'Center for Smile Enhancement',
