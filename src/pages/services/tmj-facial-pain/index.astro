---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHero from '../../../components/PageHero.astro';
import RelatedGrid from '../../../components/RelatedGrid.astro';
import CTABand from '../../../components/CTABand.astro';

const symptoms = [
  {
    title: 'Jaw Clicking or Popping',
    body: 'A clicking, popping, or grating sound when you open and close your mouth is one of the most common early signs of TMJ dysfunction.',
  },
  {
    title: 'Frequent Headaches',
    body: 'Tension-type headaches and pain around the temples are often linked to jaw muscle strain and clenching.',
  },
  {
    title: 'Ear Pain or Fullness',
    body: 'Because the jaw joint sits just in front of the ear, TMJ disorders can cause aching, pressure, or a "stuffy" sensation in the ear.',
  },
  {
    title: 'Difficulty or Pain When Chewing',
    body: 'Soreness or fatigue while eating, or a jaw that feels like it is working harder than it should, is a common complaint.',
  },
  {
    title: 'Jaw Locking or Limited Motion',
    body: 'Some patients experience a jaw that catches, locks briefly, or does not open as wide as it used to.',
  },
  {
    title: 'Facial Soreness or Tenderness',
    body: 'Tenderness along the jawline, cheeks, or temples — especially in the morning — can point to nighttime clenching or grinding.',
  },
];

const relatedItems = [
  {
    title: 'TMJ Diagnosis & Treatment',
    description: 'How we evaluate jaw pain and build a personalized treatment plan.',
    href: '/services/tmj-facial-pain/tmj-diagnosis-treatment/',
  },
  {
    title: 'Custom Night Guards',
    description: 'Precision oral appliances that protect your teeth and ease jaw strain.',
    href: '/services/tmj-facial-pain/custom-night-guards/',
  },
];
---

<BaseLayout
  title="TMJ & Facial Pain | Center for Smile Enhancement, MN"
  description="Expert diagnosis and treatment for TMJ disorders, jaw pain, headaches, and facial discomfort at Center for Smile Enhancement in Minnetonka, MN today."
>
  <Header />

  <main id="main-content">
    <PageHero
      eyebrow="TMJ & Facial Pain"
      title="Relief for Jaw Pain & TMJ Disorders"
      lede="Jaw pain, frequent headaches, and facial discomfort are more common than most people realize — and more treatable. Our team takes the time to understand what's driving your symptoms and builds a plan around your comfort."
      breadcrumbs={[
        { label: 'Home', href: '/' },
        { label: 'Services', href: '/services/' },
        { label: 'TMJ & Facial Pain' },
      ]}
      primaryCta={{ label: 'Schedule a Consultation', href: '/schedule/' }}
      secondaryCta={{ label: 'Call 952-593-9310', href: 'tel:9525939310' }}
      image="/images/service-tmj.webp"
      imageAlt="Patient experiencing relief from jaw and facial pain"
    />

    <!-- ── Symptoms ─────────────────────────────────────── -->
    <section aria-labelledby="symptoms-heading" class="section-surface">
      <div class="site-container section-py">
        <div class="section-intro">
          <span class="section-eyebrow section-eyebrow--muted">Know the Signs</span>
          <h2 id="symptoms-heading" class="section-heading page-h2">
            Signs You May Have TMJ Dysfunction
          </h2>
          <p class="section-sub">
            Temporomandibular joint (TMJ) disorders affect the joints and muscles that connect your jaw to your skull. Symptoms can range from mildly annoying to genuinely disruptive to daily life.
          </p>
        </div>

        <div class="feature-grid">
          {symptoms.map((s) => (
            <div class="card feature-card">
              <h3 class="feature-title">{s.title}</h3>
              <p class="feature-body">{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Our Approach ─────────────────────────────────── -->
    <section aria-labelledby="approach-heading" class="section-white">
      <div class="site-container section-py">
        <div class="section-intro">
          <span class="section-eyebrow section-eyebrow--muted">Our Approach</span>
          <h2 id="approach-heading" class="section-heading page-h2">
            A Thoughtful, Conservative Path to Relief
          </h2>
          <p class="section-sub">
            No two jaws are alike, so no two treatment plans should be either. We start by understanding your symptoms and history, then move toward the most conservative effective option first.
          </p>
        </div>

        <div class="approach-grid">
          <div class="card">
            <h3 class="feature-title">Careful Diagnosis</h3>
            <p class="feature-body">
              We begin with a thorough evaluation of your bite, jaw movement, and muscle tenderness to understand what's contributing to your pain before recommending any treatment.
            </p>
          </div>
          <div class="card">
            <h3 class="feature-title">Custom Night Guards</h3>
            <p class="feature-body">
              Many patients find significant relief from a precision-fitted oral appliance that reduces the impact of nighttime clenching and grinding on the jaw joint and teeth.
            </p>
          </div>
          <div class="card">
            <h3 class="feature-title">Therapeutic Botox</h3>
            <p class="feature-body">
              For appropriate candidates, Botox injections into the jaw muscles can relax overactive muscle tension and ease TMJ-related pain — the same modality used in our Masterpiece Aesthetics services, applied here for a therapeutic purpose.
            </p>
          </div>
          <div class="card">
            <h3 class="feature-title">Physical Therapy Referral</h3>
            <p class="feature-body">
              When appropriate, we coordinate with trusted physical therapy providers who specialize in jaw and facial muscle rehabilitation to support your recovery.
            </p>
          </div>
        </div>
      </div>
    </section>

    <RelatedGrid
      eyebrow="Learn More"
      heading="Explore TMJ & Facial Pain Care"
      items={relatedItems}
    />

    <CTABand
      eyebrow="TMJ & Facial Pain"
      heading="Let's Talk About Your Jaw Pain"
      sub="You don't have to live with jaw discomfort, headaches, or clicking. Schedule a consultation and let's find the source together."
      primaryCta={{ label: 'Schedule a Consultation', href: '/schedule/' }}
      secondaryCta={{ label: 'Call 952-593-9310', href: 'tel:9525939310' }}
    />
  </main>

  <Footer />
</BaseLayout>

<style>
  .section-white { background-color: #ffffff; }
  .section-surface { background-color: var(--color-surface); }

  .section-intro {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 3.5rem;
  }
  .page-h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); }
  .section-sub {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .feature-grid,
  .approach-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .feature-grid,
    .approach-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .feature-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .feature-card { height: 100%; }
  .feature-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--color-primary);
    margin-bottom: 0.625rem;
  }
  .feature-body {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }
</style>
