---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import PageHero from '../../../../components/PageHero.astro';
import RelatedGrid from '../../../../components/RelatedGrid.astro';
import CTABand from '../../../../components/CTABand.astro';

const steps = [
  {
    number: '01',
    title: 'Listen First',
    body: 'We start with a conversation — when your symptoms started, what makes them better or worse, and how they affect your daily life.',
  },
  {
    number: '02',
    title: 'Evaluate the Joint & Muscles',
    body: 'We examine your bite, jaw range of motion, and muscle tenderness around the jaw, temples, and neck to pinpoint likely contributing factors.',
  },
  {
    number: '03',
    title: 'Build a Personalized Plan',
    body: 'Together, we decide on the most conservative effective path forward, and explain exactly what to expect at each step.',
  },
];

const treatments = [
  {
    title: 'Custom Night Guards',
    body: 'A precision-fitted oral appliance is often the first line of defense, cushioning the jaw joint and reducing the effects of nighttime clenching and grinding.',
  },
  {
    title: 'Therapeutic Botox',
    body: 'Botox injections into the jaw muscles can relax chronic tension and reduce TMJ-related pain for appropriate candidates — the same treatment used cosmetically, applied here for pain relief.',
  },
  {
    title: 'Physical Therapy Referral',
    body: 'For patients who could benefit from targeted jaw and neck muscle rehabilitation, we coordinate referrals to physical therapy providers who specialize in TMJ care.',
  },
  {
    title: 'Lifestyle & Habit Guidance',
    body: 'Simple adjustments — posture, stress management, avoiding excessive gum chewing or nail biting — can meaningfully reduce strain on the jaw joint.',
  },
];

const relatedItems = [
  {
    title: 'Custom Night Guards',
    description: 'A closer look at our precision-fitted appliances for grinding and jaw protection.',
    href: '/services/tmj-facial-pain/custom-night-guards/',
  },
  {
    title: 'TMJ & Facial Pain Overview',
    description: 'Back to an overview of symptoms and treatment options for jaw and facial pain.',
    href: '/services/tmj-facial-pain/',
  },
];
---

<BaseLayout
  title="TMJ Diagnosis & Treatment | Center for Smile Enhancement, MN"
  description="Comprehensive TMJ evaluation and personalized treatment planning for jaw pain and facial discomfort at Center for Smile Enhancement in Minnetonka, MN."
>
  <Header />

  <main id="main-content">
    <PageHero
      eyebrow="TMJ Diagnosis & Treatment"
      title="A Careful, Personalized Path to Jaw Pain Relief"
      lede="Every TMJ case is different, so we don't start with a fixed protocol — we start by listening. Here's what to expect from your evaluation through your treatment plan."
      breadcrumbs={[
        { label: 'Home', href: '/' },
        { label: 'Services', href: '/services/' },
        { label: 'TMJ & Facial Pain', href: '/services/tmj-facial-pain/' },
        { label: 'TMJ Diagnosis & Treatment' },
      ]}
      primaryCta={{ label: 'Schedule a Consultation', href: '/schedule/' }}
      secondaryCta={{ label: 'Call 952-593-9310', href: 'tel:9525939310' }}
    />

    <!-- ── What to Expect ───────────────────────────────── -->
    <section aria-labelledby="steps-heading" class="section-surface">
      <div class="site-container section-py">
        <div class="section-intro">
          <span class="section-eyebrow section-eyebrow--muted">What to Expect</span>
          <h2 id="steps-heading" class="section-heading page-h2">
            Your TMJ Evaluation, Step by Step
          </h2>
        </div>

        <div class="steps-grid">
          {steps.map((s) => (
            <div class="card step-card">
              <span class="step-number">{s.number}</span>
              <h3 class="feature-title">{s.title}</h3>
              <p class="feature-body">{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Treatment Options ────────────────────────────── -->
    <section aria-labelledby="treatments-heading" class="section-white">
      <div class="site-container section-py">
        <div class="section-intro">
          <span class="section-eyebrow section-eyebrow--muted">Treatment Options</span>
          <h2 id="treatments-heading" class="section-heading page-h2">
            Treatment Options We Offer
          </h2>
          <p class="section-sub">
            We favor conservative, reversible options first, and reserve more involved treatment for cases where it's genuinely needed.
          </p>
        </div>

        <div class="feature-grid">
          {treatments.map((t) => (
            <div class="card">
              <h3 class="feature-title">{t.title}</h3>
              <p class="feature-body">{t.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <RelatedGrid
      eyebrow="Continue Exploring"
      heading="Related TMJ Care"
      items={relatedItems}
    />

    <CTABand
      eyebrow="TMJ & Facial Pain"
      heading="Ready to Get to the Root of Your Jaw Pain?"
      sub="Schedule a consultation and let's build a treatment plan around your symptoms and your life."
      primaryCta={{ label: 'Schedule a Consultation', href: '/schedule/' }}
      secondaryCta={{ label: 'Call 952-593-9310', href: 'tel:9525939310' }}
    />
  </main>

  <Footer />
</BaseLayout>

<style>
  .section-white { background-color: #ffffff; }
  .section-surface { background-color: var(--color-surface); }

  .section-intro {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 3.5rem;
  }
  .page-h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); }
  .section-sub {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .steps-grid,
  .feature-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .steps-grid,
    .feature-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .steps-grid { grid-template-columns: repeat(3, 1fr); }
    .feature-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .step-card { position: relative; }
  .step-number {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--color-brand-light);
    margin-bottom: 0.75rem;
  }
  .feature-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--color-primary);
    margin-bottom: 0.625rem;
  }
  .feature-body {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }
</style>
