---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHero from '../../../components/PageHero.astro';
import RelatedGrid from '../../../components/RelatedGrid.astro';
import CTABand from '../../../components/CTABand.astro';
import StructuredData from '../../../components/StructuredData.astro';

const provider = {
  "@type": "Dentist",
  name: "Center for Smile Enhancement",
  telephone: "+19525939310",
  email: "TheCenterforSmileEnhancement@PDPSmiles.com",
  address: {
    "@type": "PostalAddress",
    streetAddress: "10500 Wayzata Blvd.",
    addressLocality: "Minnetonka",
    addressRegion: "MN",
    postalCode: "55305",
    addressCountry: "US",
  },
};

const relatedItems = [
  {
    title: 'Cleanings & Exams',
    description: 'Routine cleanings, comprehensive exams, digital X-rays, and oral cancer screening for the whole family.',
    href: '/services/general-family-dentistry/cleanings-exams/',
  },
  {
    title: 'Routine Fillings',
    description: 'Tooth-colored composite fillings that treat decay while preserving your natural tooth structure.',
    href: '/services/general-family-dentistry/routine-fillings/',
  },
  {
    title: 'Crowns & Bridges',
    description: 'Durable, natural-looking restorations that rebuild damaged teeth and replace missing ones.',
    href: '/services/general-family-dentistry/crowns-bridges/',
  },
  {
    title: 'Root Canal Therapy',
    description: 'Gentle treatment that relieves pain from infected tooth pulp and saves your natural tooth.',
    href: '/services/general-family-dentistry/root-canal-therapy/',
  },
  {
    title: 'Extractions',
    description: 'Careful removal of teeth that can’t be saved, with a clear plan for what comes next.',
    href: '/services/general-family-dentistry/extractions/',
  },
];
---

<BaseLayout
  title="Family Dentistry | Center for Smile Enhancement | Minnetonka, MN"
  description="Comprehensive general and family dentistry in Minnetonka, MN — cleanings, exams, fillings, crowns, bridges, root canals, and extractions for all ages."
>
  <Header />

  <main id="main-content">
    <StructuredData
      type="Service"
      data={{
        name: "General & Family Dentistry",
        description: "Comprehensive general and family dentistry for patients of all ages, including preventive cleanings and exams, fillings, crowns and bridges, root canal therapy, and extractions.",
        provider,
        areaServed: { "@type": "City", name: "Minnetonka, MN" },
        url: Astro.url.href,
      }}
    />

    <PageHero
      eyebrow="General & Family Dentistry"
      title="Comprehensive Care for Every Age and Stage"
      lede="From a child's first tooth to a lifetime of routine care, our general and family dentistry services keep every member of your family's smile healthy, comfortable, and thoroughly looked after."
      breadcrumbs={[
        { label: 'Home', href: '/' },
        { label: 'Services', href: '/services/' },
        { label: 'General & Family Dentistry' },
      ]}
      primaryCta={{ label: 'Schedule an Appointment', href: '/schedule/' }}
      secondaryCta={{ label: 'Call 952-593-9310', href: 'tel:9525939310' }}
      image="/images/service-family.jpg"
      imageAlt="Mother and child brushing teeth together"
    />

    <!-- ── Our Approach ─────────────────────────────────── -->
    <section aria-labelledby="approach-heading" class="section-white">
      <div class="site-container section-py">
        <div class="section-intro">
          <span class="section-eyebrow section-eyebrow--muted">Our Approach</span>
          <h2 id="approach-heading" class="section-heading section-heading--size">
            Building Trust at Every Visit
          </h2>
          <p class="section-sub">
            We believe general dentistry is about more than treating what's in front of us — it's about building trust, nurturing comfort, and focusing on every detail of each patient's treatment plan so that optimum oral health becomes a lasting habit, not a one-time fix.
          </p>
        </div>

        <div class="benefits-grid">
          <div class="card">
            <h3 class="card-title">Care for Every Age</h3>
            <p class="card-body">
              We recommend a child's first dental visit as soon as the first tooth comes in, usually between six and twelve months. Baby teeth help children chew and speak, and they hold space in the jaw for permanent teeth — so early, gentle care matters. From there, we see patients through every decade of life.
            </p>
          </div>
          <div class="card">
            <h3 class="card-title">Every Patient Is a VIP</h3>
            <p class="card-body">
              VIP means Very Individual Patient. Whether you're bringing in a toddler for a first checkup or scheduling your own annual exam, your treatment plan is built around your specific needs, not a one-size-fits-all script.
            </p>
          </div>
          <div class="card">
            <h3 class="card-title">Disney-Inspired Comfort</h3>
            <p class="card-body">
              Since 2001, our team has trained in the Disney Institute's customer service philosophy, so routine visits feel unhurried and welcoming — for anxious kids and adults alike.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Diagnostics & Screening ──────────────────────── -->
    <section aria-labelledby="diagnostics-heading" class="section-wash">
      <div class="site-container section-py">
        <div class="section-intro">
          <span class="section-eyebrow section-eyebrow--muted">Diagnostics & Prevention</span>
          <h2 id="diagnostics-heading" class="section-heading section-heading--size">
            Catching Problems Early
          </h2>
        </div>

        <div class="benefits-grid">
          <div class="card">
            <h3 class="card-title">Digital X-Rays</h3>
            <p class="card-body">
              Digital imaging helps us detect a wide range of concerns — including decay, bone damage, and abnormal tooth positioning — often well before a problem becomes noticeable or painful.
            </p>
          </div>
          <div class="card">
            <h3 class="card-title">Oral Cancer Screening</h3>
            <p class="card-body">
              A quick, painless oral cancer screening is included as part of every routine checkup, giving you an added layer of protection with no extra visit required.
            </p>
          </div>
          <div class="card">
            <h3 class="card-title">Fluoride & Home Care</h3>
            <p class="card-body">
              We recommend brushing twice daily with a fluoridated toothpaste — a soft, child-sized brush for little ones — and we're happy to tailor home care guidance to your family's needs at any visit.
            </p>
          </div>
        </div>
      </div>
    </section>

    <RelatedGrid
      eyebrow="Explore Our Services"
      heading="General & Family Dentistry Services"
      items={relatedItems}
    />

    <CTABand
      heading="Ready to Schedule Your Family's Next Visit?"
      sub="New and returning patients of all ages are welcome. Call us or schedule online — we look forward to caring for your whole family."
    />
  </main>

  <Footer />
</BaseLayout>

<style>
  .section-white { background-color: #ffffff; }
  .section-wash { background-color: #ebeef5; }

  .section-intro {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 3.5rem;
  }
  .section-heading--size {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }
  .section-sub {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .benefits-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .benefits-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--color-primary);
    margin-bottom: 0.625rem;
  }
  .card-body {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }
</style>
