---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import PageHero from '../../../../components/PageHero.astro';
import RelatedGrid from '../../../../components/RelatedGrid.astro';
import CTABand from '../../../../components/CTABand.astro';
import StructuredData from '../../../../components/StructuredData.astro';

const provider = {
  "@type": "Dentist",
  name: "Center for Smile Enhancement",
  telephone: "+19525939310",
  email: "TheCenterforSmileEnhancement@PDPSmiles.com",
  address: {
    "@type": "PostalAddress",
    streetAddress: "10500 Wayzata Blvd.",
    addressLocality: "Minnetonka",
    addressRegion: "MN",
    postalCode: "55305",
    addressCountry: "US",
  },
};

const relatedItems = [
  {
    title: 'General & Family Dentistry',
    description: 'See the full range of general and family dental care we offer, from first checkups to restorative treatment.',
    href: '/services/general-family-dentistry/',
  },
  {
    title: 'Routine Fillings',
    description: 'Tooth-colored composite fillings that treat decay while preserving your natural tooth structure.',
    href: '/services/general-family-dentistry/routine-fillings/',
  },
  {
    title: 'Crowns & Bridges',
    description: 'Durable, natural-looking restorations that rebuild damaged teeth and replace missing ones.',
    href: '/services/general-family-dentistry/crowns-bridges/',
  },
  {
    title: 'Root Canal Therapy',
    description: 'Gentle treatment that relieves pain from infected tooth pulp and saves your natural tooth.',
    href: '/services/general-family-dentistry/root-canal-therapy/',
  },
  {
    title: 'Extractions',
    description: 'Careful removal of teeth that can’t be saved, with a clear plan for what comes next.',
    href: '/services/general-family-dentistry/extractions/',
  },
];
---

<BaseLayout
  title="Cleanings & Exams | Center for Smile Enhancement | Minnetonka, MN"
  description="Routine dental cleanings and exams in Minnetonka, MN, including digital X-rays, oral cancer screening, and sealants to keep smiles healthy at every age."
>
  <Header />

  <main id="main-content">
    <StructuredData
      type="Service"
      data={{
        name: "Cleanings & Exams",
        description: "Routine dental cleanings, comprehensive exams, digital X-rays, oral cancer screening, and preventive sealants for patients of all ages.",
        provider,
        areaServed: { "@type": "City", name: "Minnetonka, MN" },
        url: Astro.url.href,
      }}
    />

    <PageHero
      eyebrow="General & Family Dentistry"
      title="Cleanings & Exams"
      lede="Regular cleanings and comprehensive exams are the foundation of good oral health — for kids, teens, adults, and everyone in between."
      breadcrumbs={[
        { label: 'Home', href: '/' },
        { label: 'Services', href: '/services/' },
        { label: 'General & Family Dentistry', href: '/services/general-family-dentistry/' },
        { label: 'Cleanings & Exams' },
      ]}
      primaryCta={{ label: 'Schedule an Appointment', href: '/schedule/' }}
      secondaryCta={{ label: 'Call 952-593-9310', href: 'tel:9525939310' }}
    />

    <!-- ── What's Included ───────────────────────────────── -->
    <section aria-labelledby="included-heading" class="section-white">
      <div class="site-container section-py">
        <div class="section-intro">
          <span class="section-eyebrow section-eyebrow--muted">What's Included</span>
          <h2 id="included-heading" class="section-heading section-heading--size">
            A Thorough Look at Your Oral Health
          </h2>
          <p class="section-sub">
            Each visit combines hands-on cleaning with a careful clinical exam, so small issues get caught before they become big ones.
          </p>
        </div>

        <div class="benefits-grid">
          <div class="card">
            <h3 class="card-title">Professional Cleaning</h3>
            <p class="card-body">
              Our hygienists remove plaque and tartar buildup that brushing and flossing alone can't reach, then polish your teeth to a healthy, fresh finish.
            </p>
          </div>
          <div class="card">
            <h3 class="card-title">Comprehensive Exam</h3>
            <p class="card-body">
              Dr. Sudit checks for signs of decay, gum disease, and other concerns, and reviews your treatment plan with you in plain, unhurried language.
            </p>
          </div>
          <div class="card">
            <h3 class="card-title">Digital X-Rays</h3>
            <p class="card-body">
              Digital imaging helps detect decay, bone damage, and abnormal tooth positioning — often before you'd notice anything is wrong.
            </p>
          </div>
          <div class="card">
            <h3 class="card-title">Oral Cancer Screening</h3>
            <p class="card-body">
              A quick, painless oral cancer screening is included as part of every routine checkup, at no extra visit required.
            </p>
          </div>
          <div class="card">
            <h3 class="card-title">Dental Sealants</h3>
            <p class="card-body">
              For children roughly ages 6 to 14, we offer sealants — a thin protective coating painted onto the chewing surfaces of back teeth that can help guard against decay for up to 10 years.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Between Visits ────────────────────────────────── -->
    <section aria-labelledby="between-heading" class="section-wash">
      <div class="site-container section-py">
        <div class="section-intro">
          <span class="section-eyebrow section-eyebrow--muted">What to Expect</span>
          <h2 id="between-heading" class="section-heading section-heading--size">
            Keeping Your Smile Healthy Between Visits
          </h2>
          <p class="section-sub">
            Most patients benefit from a cleaning and exam roughly every six months, though your recommended schedule may differ based on your individual oral health. In the meantime, brushing twice daily with a fluoridated toothpaste — using a soft, child-sized brush for little ones — goes a long way toward keeping your next visit simple.
          </p>
          <p class="section-sub">
            Already had your cleaning and exam? Our <a href="/aftercare/cleanings-checkups/" class="inline-link">aftercare instructions</a> cover what to expect and when to call us.
          </p>
        </div>
      </div>
    </section>

    <RelatedGrid
      eyebrow="More General & Family Dentistry"
      heading="Related Services"
      items={relatedItems}
    />

    <CTABand
      heading="Ready to Schedule a Cleaning or Exam?"
      sub="New and returning patients of all ages are welcome. Call us or schedule online — we look forward to seeing your smile."
    />
  </main>

  <Footer />
</BaseLayout>

<style>
  .section-white { background-color: #ffffff; }
  .section-wash { background-color: #ebeef5; }

  .section-intro {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 3.5rem;
  }
  .section-heading--size {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }
  .section-sub {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .benefits-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .benefits-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--color-primary);
    margin-bottom: 0.625rem;
  }
  .card-body {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }
</style>
