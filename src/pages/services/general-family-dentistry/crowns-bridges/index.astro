---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import PageHero from '../../../../components/PageHero.astro';
import RelatedGrid from '../../../../components/RelatedGrid.astro';
import CTABand from '../../../../components/CTABand.astro';
import StructuredData from '../../../../components/StructuredData.astro';

const provider = {
  "@type": "Dentist",
  name: "Center for Smile Enhancement",
  telephone: "+19525939310",
  email: "TheCenterforSmileEnhancement@PDPSmiles.com",
  address: {
    "@type": "PostalAddress",
    streetAddress: "10500 Wayzata Blvd.",
    addressLocality: "Minnetonka",
    addressRegion: "MN",
    postalCode: "55305",
    addressCountry: "US",
  },
};

const relatedItems = [
  {
    title: 'General & Family Dentistry',
    description: 'See the full range of general and family dental care we offer, from first checkups to restorative treatment.',
    href: '/services/general-family-dentistry/',
  },
  {
    title: 'Cleanings & Exams',
    description: 'Routine cleanings, comprehensive exams, digital X-rays, and oral cancer screening for the whole family.',
    href: '/services/general-family-dentistry/cleanings-exams/',
  },
  {
    title: 'Routine Fillings',
    description: 'Tooth-colored composite fillings that treat decay while preserving your natural tooth structure.',
    href: '/services/general-family-dentistry/routine-fillings/',
  },
  {
    title: 'Root Canal Therapy',
    description: 'Gentle treatment that relieves pain from infected tooth pulp and saves your natural tooth.',
    href: '/services/general-family-dentistry/root-canal-therapy/',
  },
  {
    title: 'Extractions',
    description: 'Careful removal of teeth that can’t be saved, with a clear plan for what comes next.',
    href: '/services/general-family-dentistry/extractions/',
  },
];
---

<BaseLayout
  title="Crowns & Bridges | Center for Smile Enhancement | Minnetonka, MN"
  description="Custom dental crowns and bridges in Minnetonka, MN restore damaged teeth and replace missing ones, rebuilding strength, function, and a natural smile."
>
  <Header />

  <main id="main-content">
    <StructuredData
      type="MedicalProcedure"
      data={{
        name: "Dental Crowns & Bridges",
        description: "Custom crowns to restore damaged teeth and bridges to replace one or more missing teeth, rebuilding strength, function, and appearance.",
        provider,
        areaServed: { "@type": "City", name: "Minnetonka, MN" },
        url: Astro.url.href,
      }}
    />

    <PageHero
      eyebrow="General & Family Dentistry"
      title="Crowns & Bridges"
      lede="When a tooth is too damaged for a filling, or a missing tooth has left a gap, crowns and bridges restore your smile's strength, function, and appearance."
      breadcrumbs={[
        { label: 'Home', href: '/' },
        { label: 'Services', href: '/services/' },
        { label: 'General & Family Dentistry', href: '/services/general-family-dentistry/' },
        { label: 'Crowns & Bridges' },
      ]}
      primaryCta={{ label: 'Schedule an Appointment', href: '/schedule/' }}
      secondaryCta={{ label: 'Call 952-593-9310', href: 'tel:9525939310' }}
    />

    <!-- ── When You Might Need One ──────────────────────── -->
    <section aria-labelledby="need-heading" class="section-white">
      <div class="site-container section-py">
        <div class="section-intro">
          <span class="section-eyebrow section-eyebrow--muted">Restorative Care</span>
          <h2 id="need-heading" class="section-heading section-heading--size">
            When You Might Need a Crown or Bridge
          </h2>
        </div>

        <div class="benefits-grid">
          <div class="card">
            <h3 class="card-title">Dental Crowns</h3>
            <p class="card-body">
              A crown caps a cracked, heavily filled, or weakened tooth, restoring its shape and strength. Crowns are also commonly placed after root canal therapy to protect the treated tooth going forward.
            </p>
          </div>
          <div class="card">
            <h3 class="card-title">Dental Bridges</h3>
            <p class="card-body">
              A bridge replaces one or more missing teeth by anchoring a replacement tooth to the neighboring natural teeth or an implant, restoring your bite and helping keep surrounding teeth from shifting.
            </p>
          </div>
          <div class="card">
            <h3 class="card-title">Natural, Lasting Results</h3>
            <p class="card-body">
              Both are custom-crafted to match the shape and shade of your surrounding teeth, so the finished result blends in and holds up to everyday use.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── What to Expect ───────────────────────────────── -->
    <section aria-labelledby="expect-heading" class="section-wash">
      <div class="site-container section-py">
        <div class="section-intro">
          <span class="section-eyebrow section-eyebrow--muted">What to Expect</span>
          <h2 id="expect-heading" class="section-heading section-heading--size">
            A Straightforward, Multi-Visit Process
          </h2>
          <p class="section-sub">
            As is standard for crowns and bridges across general dentistry, the affected tooth or teeth are prepared and a precise impression or digital scan is taken. You'll wear a temporary restoration while your custom crown or bridge is crafted, then return for a comfortable final fitting.
          </p>
        </div>
      </div>
    </section>

    <RelatedGrid
      eyebrow="More General & Family Dentistry"
      heading="Related Services"
      items={relatedItems}
    />

    <CTABand
      heading="Considering a Crown or Bridge?"
      sub="New and returning patients are welcome. Call us or schedule online — we'll walk you through the right option for your smile."
    />
  </main>

  <Footer />
</BaseLayout>

<style>
  .section-white { background-color: #ffffff; }
  .section-wash { background-color: #ebeef5; }

  .section-intro {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 3.5rem;
  }
  .section-heading--size {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }
  .section-sub {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .benefits-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .benefits-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--color-primary);
    margin-bottom: 0.625rem;
  }
  .card-body {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }
</style>
