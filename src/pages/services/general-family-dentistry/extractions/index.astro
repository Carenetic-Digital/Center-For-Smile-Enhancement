---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import PageHero from '../../../../components/PageHero.astro';
import RelatedGrid from '../../../../components/RelatedGrid.astro';
import CTABand from '../../../../components/CTABand.astro';
import StructuredData from '../../../../components/StructuredData.astro';

const provider = {
  "@type": "Dentist",
  name: "Center for Smile Enhancement",
  telephone: "+19525939310",
  email: "TheCenterforSmileEnhancement@PDPSmiles.com",
  address: {
    "@type": "PostalAddress",
    streetAddress: "10500 Wayzata Blvd.",
    addressLocality: "Minnetonka",
    addressRegion: "MN",
    postalCode: "55305",
    addressCountry: "US",
  },
};

const relatedItems = [
  {
    title: 'General & Family Dentistry',
    description: 'See the full range of general and family dental care we offer, from first checkups to restorative treatment.',
    href: '/services/general-family-dentistry/',
  },
  {
    title: 'Cleanings & Exams',
    description: 'Routine cleanings, comprehensive exams, digital X-rays, and oral cancer screening for the whole family.',
    href: '/services/general-family-dentistry/cleanings-exams/',
  },
  {
    title: 'Routine Fillings',
    description: 'Tooth-colored composite fillings that treat decay while preserving your natural tooth structure.',
    href: '/services/general-family-dentistry/routine-fillings/',
  },
  {
    title: 'Crowns & Bridges',
    description: 'Durable, natural-looking restorations that rebuild damaged teeth and replace missing ones.',
    href: '/services/general-family-dentistry/crowns-bridges/',
  },
  {
    title: 'Root Canal Therapy',
    description: 'Gentle treatment that relieves pain from infected tooth pulp and saves your natural tooth.',
    href: '/services/general-family-dentistry/root-canal-therapy/',
  },
];
---

<BaseLayout
  title="Extractions | Center for Smile Enhancement | Minnetonka, MN"
  description="Comfortable tooth extractions in Minnetonka, MN for teeth that can't be saved, performed with care and a clear plan for restoring your smile afterward."
>
  <Header />

  <main id="main-content">
    <StructuredData
      type="MedicalProcedure"
      data={{
        name: "Tooth Extractions",
        description: "Removal of teeth that are too damaged, decayed, or crowded to be saved, performed comfortably with clear aftercare guidance.",
        provider,
        areaServed: { "@type": "City", name: "Minnetonka, MN" },
        url: Astro.url.href,
      }}
    />

    <PageHero
      eyebrow="General & Family Dentistry"
      title="Extractions"
      lede="When a tooth is too damaged, decayed, or crowded to be saved, an extraction lets us resolve the problem comfortably and plan for what comes next."
      breadcrumbs={[
        { label: 'Home', href: '/' },
        { label: 'Services', href: '/services/' },
        { label: 'General & Family Dentistry', href: '/services/general-family-dentistry/' },
        { label: 'Extractions' },
      ]}
      primaryCta={{ label: 'Schedule an Appointment', href: '/schedule/' }}
      secondaryCta={{ label: 'Call 952-593-9310', href: 'tel:9525939310' }}
    />

    <!-- ── When It's Needed ──────────────────────────────── -->
    <section aria-labelledby="need-heading" class="section-white">
      <div class="site-container section-py">
        <div class="section-intro">
          <span class="section-eyebrow section-eyebrow--muted">When It's Needed</span>
          <h2 id="need-heading" class="section-heading section-heading--size">
            When a Tooth Can't Be Saved
          </h2>
          <p class="section-sub">
            We always look for a way to save a natural tooth first. An extraction is generally recommended only when a filling, crown, or root canal isn't enough — for example, with severe decay or infection, advanced gum disease, a tooth broken beyond repair, or crowding that's affecting your bite or orthodontic treatment.
          </p>
        </div>

        <div class="benefits-grid">
          <div class="card">
            <h3 class="card-title">A Careful, Comfortable Process</h3>
            <p class="card-body">
              As with any extraction, the area is thoroughly numbed first, and the tooth is removed using a gentle, deliberate technique focused on your comfort throughout.
            </p>
          </div>
          <div class="card">
            <h3 class="card-title">Clear Aftercare Guidance</h3>
            <p class="card-body">
              You'll leave with straightforward aftercare instructions to support healing, so you know exactly what to do — and what to avoid — in the days that follow.
            </p>
          </div>
          <div class="card">
            <h3 class="card-title">Planning What's Next</h3>
            <p class="card-body">
              If a replacement tooth is needed, we'll talk through your options, whether that's a bridge or a dental implant, so your bite and smile stay complete.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Healing & Aftercare ───────────────────────────── -->
    <section aria-labelledby="healing-heading" class="section-wash">
      <div class="site-container section-py">
        <div class="section-intro">
          <span class="section-eyebrow section-eyebrow--muted">What to Expect</span>
          <h2 id="healing-heading" class="section-heading section-heading--size">
            Healing After Your Extraction
          </h2>
          <p class="section-sub">
            As is typical after any extraction, mild swelling or tenderness in the first day or two is normal. Sticking to softer foods, resting, and following the aftercare instructions we provide will help you heal smoothly and comfortably.
          </p>
        </div>
      </div>
    </section>

    <RelatedGrid
      eyebrow="More General & Family Dentistry"
      heading="Related Services"
      items={relatedItems}
    />

    <CTABand
      heading="Have a Tooth That's Causing Trouble?"
      sub="New and returning patients are welcome. Call us or schedule online — we'll help you find the most comfortable path forward."
    />
  </main>

  <Footer />
</BaseLayout>

<style>
  .section-white { background-color: #ffffff; }
  .section-wash { background-color: #ebeef5; }

  .section-intro {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 3.5rem;
  }
  .section-heading--size {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }
  .section-sub {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .benefits-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .benefits-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--color-primary);
    margin-bottom: 0.625rem;
  }
  .card-body {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }
</style>
