---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import PageHero from '../../../../components/PageHero.astro';
import RelatedGrid from '../../../../components/RelatedGrid.astro';
import CTABand from '../../../../components/CTABand.astro';
import StructuredData from '../../../../components/StructuredData.astro';

const provider = {
  "@type": "Dentist",
  name: "Center for Smile Enhancement",
  telephone: "+19525939310",
  email: "TheCenterforSmileEnhancement@PDPSmiles.com",
  address: {
    "@type": "PostalAddress",
    streetAddress: "10500 Wayzata Blvd.",
    addressLocality: "Minnetonka",
    addressRegion: "MN",
    postalCode: "55305",
    addressCountry: "US",
  },
};

const relatedItems = [
  {
    title: 'General & Family Dentistry',
    description: 'See the full range of general and family dental care we offer, from first checkups to restorative treatment.',
    href: '/services/general-family-dentistry/',
  },
  {
    title: 'Cleanings & Exams',
    description: 'Routine cleanings, comprehensive exams, digital X-rays, and oral cancer screening for the whole family.',
    href: '/services/general-family-dentistry/cleanings-exams/',
  },
  {
    title: 'Crowns & Bridges',
    description: 'Durable, natural-looking restorations that rebuild damaged teeth and replace missing ones.',
    href: '/services/general-family-dentistry/crowns-bridges/',
  },
  {
    title: 'Root Canal Therapy',
    description: 'Gentle treatment that relieves pain from infected tooth pulp and saves your natural tooth.',
    href: '/services/general-family-dentistry/root-canal-therapy/',
  },
  {
    title: 'Extractions',
    description: 'Careful removal of teeth that can’t be saved, with a clear plan for what comes next.',
    href: '/services/general-family-dentistry/extractions/',
  },
];
---

<BaseLayout
  title="Routine Fillings | Center for Smile Enhancement | Minnetonka, MN"
  description="Tooth-colored composite fillings in Minnetonka, MN restore decayed teeth naturally and comfortably, preserving healthy tooth structure for lasting results."
>
  <Header />

  <main id="main-content">
    <StructuredData
      type="MedicalProcedure"
      data={{
        name: "Composite Dental Fillings",
        description: "Tooth-colored composite fillings used to treat tooth decay, restoring shape and function while preserving healthy tooth structure.",
        provider,
        areaServed: { "@type": "City", name: "Minnetonka, MN" },
        url: Astro.url.href,
      }}
    />

    <PageHero
      eyebrow="General & Family Dentistry"
      title="Routine Fillings"
      lede="When a cavity is caught early, a filling is often all it takes to stop decay in its tracks and restore your tooth's strength — whether it's your first cavity or you're replacing an older filling."
      breadcrumbs={[
        { label: 'Home', href: '/' },
        { label: 'Services', href: '/services/' },
        { label: 'General & Family Dentistry', href: '/services/general-family-dentistry/' },
        { label: 'Routine Fillings' },
      ]}
      primaryCta={{ label: 'Schedule an Appointment', href: '/schedule/' }}
      secondaryCta={{ label: 'Call 952-593-9310', href: 'tel:9525939310' }}
    />

    <!-- ── Composite Is Our Standard ─────────────────────── -->
    <section aria-labelledby="composite-heading" class="section-white">
      <div class="site-container section-py">
        <div class="section-intro">
          <span class="section-eyebrow section-eyebrow--muted">Tooth-Colored Fillings</span>
          <h2 id="composite-heading" class="section-heading section-heading--size">
            Composite Is Our Standard Today
          </h2>
          <p class="section-sub">
            Composite (tooth-colored) fillings are the material we use for the vast majority of patients today. Made from a durable resin that's shade-matched to your natural teeth, composite bonds directly to the tooth and blends in seamlessly. Amalgam (silver) fillings, once the industry default, are now used only rarely in dentistry generally — composite is our routine choice for treating decay.
          </p>
        </div>

        <div class="benefits-grid">
          <div class="card">
            <h3 class="card-title">Naturally Blends In</h3>
            <p class="card-body">
              Composite resin is matched to the shade of your surrounding teeth, so the filling is virtually invisible when you smile, talk, or laugh.
            </p>
          </div>
          <div class="card">
            <h3 class="card-title">Preserves More Tooth</h3>
            <p class="card-body">
              Because composite bonds directly to tooth structure, less of your natural tooth typically needs to be removed compared to older filling materials.
            </p>
          </div>
          <div class="card">
            <h3 class="card-title">Efficient, Comfortable Visit</h3>
            <p class="card-body">
              Most routine fillings are completed comfortably in a single visit, with a bite check before you leave to make sure everything feels just right.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── What to Expect ───────────────────────────────── -->
    <section aria-labelledby="expect-heading" class="section-wash">
      <div class="site-container section-py">
        <div class="section-intro">
          <span class="section-eyebrow section-eyebrow--muted">What to Expect</span>
          <h2 id="expect-heading" class="section-heading section-heading--size">
            A Straightforward, Comfortable Process
          </h2>
          <p class="section-sub">
            As with most routine fillings, you can generally expect the area to be gently numbed, the decayed portion of the tooth carefully removed, and the composite filling placed, shaped, and polished to match your bite — a standard, well-established process used across general dentistry.
          </p>
          <p class="section-sub">
            Already had your filling? Our <a href="/aftercare/routine-fillings/" class="inline-link">aftercare instructions</a> cover what to expect and when to call us.
          </p>
        </div>
      </div>
    </section>

    <RelatedGrid
      eyebrow="More General & Family Dentistry"
      heading="Related Services"
      items={relatedItems}
    />

    <CTABand
      heading="Have a Cavity That Needs Attention?"
      sub="New and returning patients are welcome. Call us or schedule online — we'll get you comfortable and taken care of quickly."
    />
  </main>

  <Footer />
</BaseLayout>

<style>
  .section-white { background-color: #ffffff; }
  .section-wash { background-color: #ebeef5; }

  .section-intro {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 3.5rem;
  }
  .section-heading--size {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }
  .section-sub {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .benefits-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .benefits-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--color-primary);
    margin-bottom: 0.625rem;
  }
  .card-body {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }
</style>
