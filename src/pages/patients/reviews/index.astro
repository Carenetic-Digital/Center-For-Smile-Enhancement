---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHero from '../../../components/PageHero.astro';
import CTABand from '../../../components/CTABand.astro';
---

<BaseLayout
  title="Patient Reviews | Center for Smile Enhancement, MN"
  description="Real patient stories about Dr. Michael Sudit and his caring team at the Center for Smile Enhancement in Minnetonka, Minnesota."
>
  <Header />

  <main id="main-content">
    <PageHero
      eyebrow="Patient Stories"
      title="What Our Patients Are Saying"
      lede="Nothing means more to us than the trust our patients place in our care. Here's a look at what they have to say."
      breadcrumbs={[
        { label: 'Home', href: '/' },
        { label: 'Patients', href: '/patients/' },
        { label: 'Reviews' },
      ]}
    />

    <!-- ── Review quotes ────────────────────────────────────── -->
    <section aria-labelledby="quotes-heading" class="section-surface">
      <div class="site-container section-py">
        <div class="section-intro">
          <span class="section-eyebrow section-eyebrow--muted">In Their Words</span>
          <h2 id="quotes-heading" class="section-heading section-heading-size">
            Real Stories From Real Patients
          </h2>
        </div>

        <!-- Elfsight Google Reviews | Untitled Google Reviews -->
        <script is:inline src="https://elfsightcdn.com/platform.js" async></script>
        <div class="elfsight-app-e2c44335-6888-4d70-8594-1b935c3d292f" data-elfsight-app-lazy></div>
      </div>
    </section>

    <CTABand />
  </main>

  <Footer />
</BaseLayout>

<style>
  .section-white { background-color: #ffffff; }
  .section-surface { background-color: var(--color-surface); }
  .section-heading-size { font-size: clamp(1.75rem, 3vw, 2.5rem); }

  .section-intro {
    text-align: center;
    max-width: 36rem;
    margin: 0 auto 3.5rem;
  }

</style>
