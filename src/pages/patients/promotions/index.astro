---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHero from '../../../components/PageHero.astro';
import CTABand from '../../../components/CTABand.astro';
---

<BaseLayout
  title="Promotions & Specials | Center for Smile Enhancement, MN"
  description="Seasonal offers and specials from the Center for Smile Enhancement in Minnetonka, MN. Check back soon, or call our office to ask about current promotions."
>
  <Header />

  <main id="main-content">
    <PageHero
      eyebrow="Promotions"
      title="Seasonal Offers & Specials"
      breadcrumbs={[
        { label: 'Home', href: '/' },
        { label: 'Patients', href: '/patients/' },
        { label: 'Promotions' },
      ]}
    />

    <section aria-labelledby="placeholder-heading" class="section-surface">
      <div class="site-container section-py">
        <div class="placeholder-card">
          <span class="section-eyebrow section-eyebrow--muted">Nothing Posted Yet</span>
          <h2 id="placeholder-heading" class="placeholder-heading">
            Check Back Soon
          </h2>
          <p class="placeholder-body">
            Check back soon for seasonal offers and specials, or call our office at
            <a href="tel:9525939310" class="placeholder-link">952-593-9310</a>
            to ask about current promotions.
          </p>
          <div class="placeholder-ctas">
            <a href="tel:9525939310" class="btn btn-primary">Call 952-593-9310</a>
            <a href="/schedule/" class="btn btn-outline">Schedule an Appointment</a>
          </div>
        </div>
      </div>
    </section>

    <CTABand />
  </main>

  <Footer />
</BaseLayout>

<style>
  .section-surface { background-color: var(--color-surface); }

  .placeholder-card {
    max-width: 40rem;
    margin: 0 auto;
    background-color: #ffffff;
    border-radius: 1.5rem;
    padding: 3rem 2.5rem;
    text-align: center;
    border: 1px solid rgba(30, 52, 96, 0.07);
    box-shadow: 0 2px 8px rgba(30, 52, 96, 0.06), 0 12px 32px rgba(30, 52, 96, 0.14);
  }
  .placeholder-heading {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-primary);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.25;
    margin-bottom: 1rem;
  }
  .placeholder-body {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }
  .placeholder-link {
    color: var(--color-primary);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
  }
  .placeholder-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
</style>
