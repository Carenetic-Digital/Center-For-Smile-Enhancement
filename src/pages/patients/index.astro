---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import CTABand from '../../components/CTABand.astro';

const resources = [
  {
    title: 'New Patients',
    description: 'What to expect at your first visit, and how we prepare to welcome you.',
    href: '/patients/new-patients/',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
  {
    title: 'Patient Forms',
    description: 'What to know about your paperwork before you arrive for your appointment.',
    href: '/patients/patient-forms/',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
  },
  {
    title: 'Insurance & Payment',
    description: "We're out-of-network fee-for-service and accept CareCredit, Cherry, and offer a prepay discount.",
    href: '/patients/insurance-payment/',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>`,
  },
  {
    title: 'FAQ',
    description: 'Answers to common questions about your dental health and our practice.',
    href: '/patients/faq/',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
  },
  {
    title: 'Patient Reviews',
    description: '272 five-star Google reviews and real stories from our patients.',
    href: '/patients/reviews/',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
  },
  {
    title: 'Promotions',
    description: 'Seasonal offers and specials — check back soon.',
    href: '/patients/promotions/',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41L11 3.83V3a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h.83l9.58 9.59a2 2 0 0 0 2.83 0l3.35-3.35a2 2 0 0 0 0-2.83z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>`,
  },
];
---

<BaseLayout
  title="Patient Resources | Center for Smile Enhancement, MN"
  description="Everything our Minnetonka, MN patients need in one place — new patient info, forms, insurance and payment options, FAQs, reviews, and current promotions."
>
  <Header />

  <main id="main-content">
    <PageHero
      eyebrow="For Our Patients"
      title="Patient Resources"
      lede="Whether you're preparing for your first visit or you've been part of our practice family for years, everything you need is right here — from paperwork and payment options to answers about your care."
      breadcrumbs={[
        { label: 'Home', href: '/' },
        { label: 'Patients' },
      ]}
    />

    <section aria-labelledby="resources-heading" class="section-surface">
      <div class="site-container section-py">
        <h2 id="resources-heading" class="sr-only">Patient resource pages</h2>
        <div class="resources-grid">
          {resources.map((res) => (
            <a href={res.href} class="card resource-card">
              <div class="icon-badge" set:html={res.icon} />
              <h3 class="resource-card-title">{res.title}</h3>
              <p class="resource-card-body">{res.description}</p>
              <span class="resource-card-cta" aria-hidden="true">
                Learn more
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <CTABand />
  </main>

  <Footer />
</BaseLayout>

<style>
  .section-surface { background-color: var(--color-surface); }

  .resources-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .resources-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .resources-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .resource-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }
  .icon-badge {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 999px;
    background-color: var(--color-brand-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    color: var(--color-primary);
    flex-shrink: 0;
  }
  .resource-card-title {
    font-size: 1.0625rem;
    font-weight: 600;
    font-family: var(--font-display);
    color: var(--color-primary);
    margin-bottom: 0.625rem;
  }
  .resource-card-body {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    flex-grow: 1;
  }
  .resource-card-cta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
</style>
