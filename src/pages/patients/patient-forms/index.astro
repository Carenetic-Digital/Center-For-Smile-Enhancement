---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHero from '../../../components/PageHero.astro';
import CTABand from '../../../components/CTABand.astro';
---

<BaseLayout
  title="Patient Forms | The Center for Smile Enhancement, MN"
  description="New patient paperwork at the Center for Smile Enhancement in Minnetonka, MN. Online forms are being finalized — call ahead and we'll help you get a head start."
>
  <Header />

  <main id="main-content">
    <PageHero
      eyebrow="Patient Forms"
      title="Get a Head Start on Your Paperwork"
      lede="Completing your patient forms before your visit helps us make the most of your time in the chair — and lets our team prepare for your specific needs before you arrive."
      breadcrumbs={[
        { label: 'Home', href: '/' },
        { label: 'Patients', href: '/patients/' },
        { label: 'Patient Forms' },
      ]}
    />

    <!-- ── What forms are for ─────────────────────────────── -->
    <section aria-labelledby="forms-heading" class="section-white">
      <div class="site-container section-py">
        <div class="section-intro">
          <span class="section-eyebrow section-eyebrow--muted">Before Your Visit</span>
          <h2 id="forms-heading" class="section-heading section-heading-size">
            Why We Ask You to Fill Out Forms
          </h2>
          <p class="section-sub">
            New patient paperwork gives Dr. Sudit and our team the health history, insurance details, and consent information we need to provide safe, personalized care from the moment your appointment begins. Completing forms in advance means less time in the waiting room and more time focused on you.
          </p>
        </div>
      </div>
    </section>

    <!-- ── Patient forms embed ────────────────────────────── -->
    <section aria-labelledby="placeholder-heading" class="section-surface">
      <div class="site-container section-py">
        <h2 id="placeholder-heading" class="sr-only">Patient Forms</h2>
        <!-- Drop form embed placeholder — replace this block with the Drop embed once the form is provided; see docs/third-party-scripts.md for is:inline + CSP requirements -->
        <div class="embed-placeholder">
          <span class="embed-placeholder-label">Placeholder</span>
          <p class="embed-placeholder-text">A Drop form embed will go here.</p>
        </div>
      </div>
    </section>

    <CTABand />
  </main>

  <Footer />
</BaseLayout>

<style>
  .section-white { background-color: #ffffff; }
  .section-surface { background-color: var(--color-surface); }
  .section-heading-size { font-size: clamp(1.75rem, 3vw, 2.5rem); }

  .section-intro {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto;
  }
  .section-sub {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  /* ── Embed placeholder ────────────────────────────────── */
  .embed-placeholder {
    max-width: 44rem;
    margin: 0 auto;
    padding: 3.5rem 1.5rem;
    text-align: center;
    border: 2px dashed rgba(30, 52, 96, 0.2);
    border-radius: 0.75rem;
    background-color: #ffffff;
  }
  .embed-placeholder-label {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }
  .embed-placeholder-text {
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--color-primary);
    margin: 0;
  }
</style>
