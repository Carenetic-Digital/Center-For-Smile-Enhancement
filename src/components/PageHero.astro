---
// component-builder: PageHero
// Purpose: Standard interior-page hero — breadcrumb, eyebrow, H1, lede, optional CTAs and photo.

interface Crumb {
  label: string;
  href?: string;
}

interface CTA {
  label: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  breadcrumbs: Crumb[];
  primaryCta?: CTA;
  secondaryCta?: CTA;
  image?: string;
  imageAlt?: string;
}

const {
  eyebrow,
  title,
  lede,
  breadcrumbs,
  primaryCta,
  secondaryCta,
  image,
  imageAlt,
} = Astro.props;
---

<section aria-label="Page introduction" class="page-hero">
  <div class="site-container">
    <nav aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        {breadcrumbs.map((crumb, i) => (
          <li class="breadcrumb-item">
            {crumb.href && i < breadcrumbs.length - 1 ? (
              <a href={crumb.href} class="breadcrumb-link">{crumb.label}</a>
            ) : (
              <span aria-current="page">{crumb.label}</span>
            )}
            {i < breadcrumbs.length - 1 && <span class="breadcrumb-sep" aria-hidden="true">/</span>}
          </li>
        ))}
      </ol>
    </nav>

    <div class:list={["page-hero-layout", { "page-hero-layout--with-image": !!image }]}>
      <div class="page-hero-text">
        {eyebrow && <span class="section-eyebrow">{eyebrow}</span>}
        <h1 class="page-hero-h1">{title}</h1>
        {lede && <p class="page-hero-lede">{lede}</p>}
        {(primaryCta || secondaryCta) && (
          <div class="page-hero-ctas">
            {primaryCta && <a href={primaryCta.href} class="btn btn-primary">{primaryCta.label}</a>}
            {secondaryCta && <a href={secondaryCta.href} class="btn btn-outline">{secondaryCta.label}</a>}
          </div>
        )}
      </div>

      {image && (
        <div class="page-hero-photo-wrap">
          <div class="page-hero-photo-blob" aria-hidden="true"></div>
          <div class="page-hero-photo-inner">
            <img
              src={image}
              alt={imageAlt || ''}
              width="1600"
              height="1200"
              loading="eager"
              fetchpriority="high"
              class="page-hero-photo-img"
            />
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .page-hero {
    background-color: #ffffff;
    padding-top: 2.5rem;
    padding-bottom: 3.5rem;
  }

  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }
  .breadcrumb-item { display: inline-flex; align-items: center; }
  .breadcrumb-link { color: var(--color-text-muted); transition: color 0.15s; }
  .breadcrumb-link:hover { color: var(--color-primary); }
  .breadcrumb-sep { margin: 0 0.5rem; color: var(--color-border); }
  .breadcrumb-item span[aria-current="page"] { color: var(--color-primary); font-weight: 500; }

  .page-hero-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    max-width: 44rem;
  }
  .page-hero-layout--with-image {
    max-width: none;
  }
  @media (min-width: 768px) {
    .page-hero-layout--with-image { grid-template-columns: 3fr 2fr; gap: 3.5rem; }
  }

  .page-hero-h1 {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1.18;
    font-size: clamp(2rem, 4.2vw, 3rem);
  }
  .page-hero-lede {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    margin-top: 1.25rem;
  }
  .page-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .page-hero-photo-wrap {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 26rem;
  }
  @media (min-width: 768px) {
    .page-hero-photo-wrap { justify-self: end; }
  }
  .page-hero-photo-blob {
    position: absolute;
    top: -1.5rem;
    right: -1.25rem;
    width: 88%;
    height: 88%;
    background-color: var(--color-brand-light);
    border-radius: 3.5rem 3.5rem 1rem 3.5rem;
    z-index: 0;
  }
  .page-hero-photo-inner {
    position: relative;
    z-index: 1;
    background-color: var(--color-surface);
    height: 320px;
    overflow: hidden;
    border-radius: 3.5rem 3.5rem 1rem 3.5rem;
    box-shadow: 0 24px 48px rgba(30, 52, 96, 0.16);
  }
  @media (min-width: 640px) {
    .page-hero-photo-inner { height: 360px; }
  }
  .page-hero-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
