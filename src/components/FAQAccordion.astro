---
// component-builder: FAQAccordion
// Purpose: Accessible accordion for Q&A content, with FAQPage structured data.
import StructuredData from './StructuredData.astro';

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
  idPrefix?: string;
  includeSchema?: boolean;
}

const { items, idPrefix = 'faq', includeSchema = true } = Astro.props;

const faqSchema = {
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

{includeSchema && <StructuredData type="FAQPage" data={faqSchema} />}

<div class="faq-accordion">
  {items.map((item, i) => {
    const panelId = `${idPrefix}-panel-${i}`;
    const btnId = `${idPrefix}-btn-${i}`;
    return (
      <div class="faq-item">
        <h3 class="faq-question-heading">
          <button
            id={btnId}
            class="faq-trigger"
            aria-expanded="false"
            aria-controls={panelId}
          >
            <span>{item.question}</span>
            <svg class="faq-chevron" width="14" height="14" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </h3>
        <div id={panelId} class="faq-panel" role="region" aria-labelledby={btnId} hidden>
          <p class="faq-answer">{item.answer}</p>
        </div>
      </div>
    );
  })}
</div>

<style>
  .faq-accordion {
    display: flex;
    flex-direction: column;
    max-width: 48rem;
    margin: 0 auto;
  }
  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }
  .faq-question-heading { margin: 0; }
  .faq-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    text-align: left;
    background: none;
    border: none;
    cursor: pointer;
    padding: 1.375rem 0.25rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--color-primary);
  }
  .faq-chevron {
    flex-shrink: 0;
    color: var(--color-primary);
    transition: transform 0.2s ease;
  }
  .faq-trigger[aria-expanded="true"] .faq-chevron {
    transform: rotate(180deg);
  }
  .faq-panel {
    padding: 0 0.25rem 1.5rem;
  }
  .faq-answer {
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--color-text-muted);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.faq-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const panel = document.getElementById(btn.getAttribute('aria-controls') || '');
      btn.setAttribute('aria-expanded', String(!expanded));
      panel?.toggleAttribute('hidden', expanded);
    });
  });
</script>
